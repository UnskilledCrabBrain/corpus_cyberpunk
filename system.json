      "type": "Item",
      "system": "corpus",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "corpus-implants",
      "label": "Импланты",
      "path": "packs/corpus-implants",
      "type": "Item",
      "system": "corpus",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "corpus-genetics",
      "label": "Генетика",
      "path": "packs/corpus-genetics",
      "type": "Item",
      "system": "corpus",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
