      },
      "trait": {
        "htmlFields": [
          "description"
        ]
      },
      "weapon": {
        "htmlFields": [
          "description"
        ]
      },
      "armor": {
        "htmlFields": [
          "description"
        ]
      },
      "implant": {
        "htmlFields": [
          "description"
        ]
      },
      "genetic": {
        "htmlFields": [
          "description"
        ]
      },
      "condition": {
        "htmlFields": [
          "description"
        ]
      },
      "maneuver": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "packs": [
    {
      "name": "corpus-weapons",
