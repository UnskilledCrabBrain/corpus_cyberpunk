{
  "id": "corpus",
  "title": "Corpus",
  "description": "A custom tabletop roleplaying game system for Foundry Virtual Tabletop.",
  "version": "0.6.37",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "authors": [
    {
      "name": "Corpus Authors"
    }
  ],
  "esmodules": [
    "module/corpus-0.6.37.mjs"
  ],
  "styles": [
    "styles/corpus-0.6.37.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "ru",
