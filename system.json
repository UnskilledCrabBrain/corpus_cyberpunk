  "packFolders": [
    {
      "name": "Corpus — справочники",
      "color": "#a43f35",
      "sorting": "m",
      "packs": [
        "corpus-weapons",
        "corpus-armor",
        "corpus-implants",
        "corpus-genetics",
        "corpus-maneuvers"
      ]
    }
